# Get your bot token from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Your numeric Telegram user ID (send /myid to the bot to find out)
OWNER_CHAT_ID=123456789

# Optional: PostgreSQL connection string (falls back to local SQLite if empty)
DATABASE_URL=

# Optional: set when deploying as a Web Service (Render sets RENDER_EXTERNAL_URL automatically)
WEBHOOK_URL=
WEBHOOK_SECRET=
